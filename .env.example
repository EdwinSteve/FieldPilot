# Copy to .env and fill in. Never commit .env.

# --- Agent (Meta Model API · Muse Spark) ---
# MOCK_LLM=1 uses recorded deterministic responses and never calls the network.
MOCK_LLM=1
MUSE_API_KEY=
MUSE_API_BASE_URL=https://api.meta.ai/v1
# Model ids are required when MOCK_LLM=0. They are never hardcoded in code.
MUSE_AGENT_MODEL=muse-spark-1.3
MUSE_SEGMENTATION_MODEL=sam-3.1
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Agent loop limits. `make preflight` checks the key against the three model ids.
# AGENT_MAX_TURNS=12
# MUSE_TIMEOUT_SECONDS=30

# --- Persistence ---
# Defaults to backend/fieldpilot.db when unset.
# DATABASE_URL=sqlite:///./fieldpilot.db

# --- Profile and demo overrides ---
# dev (default), demo or prod.
# APP_PROFILE=dev
# Shortens the 6 h NOTIFY revert window (seconds of simulated time). Honoured
# only when APP_PROFILE=demo, and never longer than autonomy.yaml; with any
# other profile, setting it stops the app at startup (D010, D036).
# DEMO_REVERT_WINDOW_SECONDS=600

# --- Login and sessions (D082) ---
# Every route needs a token except /health and the public /auth routes.
# AUTH_REQUIRED=0 lets the current dashboard run without a login screen, and
# is honoured only when APP_PROFILE=demo; with any other profile the app stops.
# AUTH_REQUIRED=1
# Signs the access tokens: at least 32 characters, required when APP_PROFILE=prod.
# Without it, dev and demo generate one per process (sessions end at restart).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_JWT_SECRET=

# --- Crop planner (stage 1, D079, D081) ---
# Defaults to the newest folder in planner/models/; B0 is served if it was not adopted.
# PLANNER_BUNDLE=planner/models/planner-2026-11-03
