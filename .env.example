# Copy to .env and fill in. Never commit .env.

# --- Agent (Meta Model API · Muse Spark) ---
# MOCK_LLM=1 uses recorded deterministic responses and never calls the network.
MOCK_LLM=1
MUSE_API_KEY=
MUSE_API_BASE_URL=
# Model id is required when MOCK_LLM=0. It is never hardcoded.
MUSE_AGENT_MODEL=

# --- Persistence ---
# Defaults to backend/fieldpilot.db when unset.
# DATABASE_URL=sqlite:///./fieldpilot.db

# --- Profile and demo overrides ---
# dev (default), demo or prod.
# APP_PROFILE=dev
# Shortens the 6 h NOTIFY revert window (seconds of simulated time). Honoured
# only when APP_PROFILE=demo, and never longer than autonomy.yaml; with any
# other profile, setting it stops the app at startup (D010, D036).
# DEMO_REVERT_WINDOW_SECONDS=600
